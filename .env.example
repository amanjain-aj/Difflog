# =========================================================================
# SpecSync Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# =========================================================================

# 1. Groq API Key (REQUIRED for /api/v1/ingest LLM summarization — https://console.groq.com/keys)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Supabase (OPTIONAL locally — automatically uses .data/specsync-db.json if omitted)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 3. Stripe Billing (OPTIONAL locally — simulates checkout flow if omitted)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID="price_starter_29_monthly"
STRIPE_GROWTH_PRICE_ID="price_growth_79_monthly"
STRIPE_SCALE_PRICE_ID="price_scale_199_monthly"

# 4. Application URL & Outbound Notifications
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
