{
  "commit_hash": "9f84c21e7b03a5d1c8e2b4f6a90123456789abcd",
  "commit_message": "feat(payments): enforce Idempotency-Key on POST /v1/payments, add /v1/payouts/instant, deprecate /v1/charges/legacy",
  "version_tag": "v2026.10.30",
  "diff": {
    "endpoints": {
      "added": [
        {
          "method": "POST",
          "path": "/v1/payouts/instant",
          "summary": "Trigger an instant real-time RTP/FedNow merchant payout"
        }
      ],
      "removed": [],
      "modified": [
        {
          "method": "POST",
          "path": "/v1/payments",
          "parameters": {
            "added": [
              {
                "name": "Idempotency-Key",
                "in": "header",
                "required": true
              }
            ]
          },
          "requestBody": {
            "requiredPropertiesAdded": ["payment_method_types"],
            "propertiesAdded": ["settlement_currency", "payment_method_types"],
            "enumValuesAdded": {
              "currency": ["jpy", "cad", "aud"],
              "capture_method": ["automatic_async"]
            }
          }
        },
        {
          "method": "POST",
          "path": "/v1/charges/legacy",
          "deprecated": {
            "from": false,
            "to": true
          }
        },
        {
          "method": "GET",
          "path": "/v1/customers/{customer_id}",
          "parameters": {
            "added": [
              {
                "name": "expand_risk_profile",
                "in": "query",
                "required": false
              }
            ]
          }
        }
      ]
    }
  },
  "breaking": [
    {
      "id": "request-parameter-became-required",
      "level": "ERR",
      "text": "added the new required 'header' request parameter 'Idempotency-Key'",
      "operation": "POST",
      "path": "/v1/payments"
    },
    {
      "id": "new-required-request-property",
      "level": "ERR",
      "text": "added the new required property 'payment_method_types' to the request body",
      "operation": "POST",
      "path": "/v1/payments"
    }
  ]
}
